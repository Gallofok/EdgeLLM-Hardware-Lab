*.sh text eol=lf
*.py text eol=lf
# Measurement hashes require exact bytes on every checkout, including CSV CRLF.
/results/pi3/** -text whitespace=cr-at-eol
/results/kernels/** -text whitespace=cr-at-eol
/results/profiling/** -text whitespace=cr-at-eol
/results/kernels/*/CMakeCache.txt whitespace=cr-at-eol,-blank-at-eof
/results/profiling/*/raw/engine-CMakeCache.txt whitespace=cr-at-eol,-blank-at-eof
/reports/pi3-profile-20261031/*.csv -text whitespace=cr-at-eol
/results/profiling/*/raw/perf-capability.stderr.txt whitespace=-blank-at-eol,-blank-at-eof
/results/quantized/** -text whitespace=cr-at-eol
/results/quantized/*/raw/CMakeCache.txt whitespace=cr-at-eol,-blank-at-eof
/reports/pi3-q5-neon-20261031/*.csv -text whitespace=cr-at-eol

# Unified diff context uses a mandatory space on otherwise blank lines.
/integrations/ggml/*.patch whitespace=-blank-at-eol
/results/integration/** -text whitespace=cr-at-eol
/reports/pi3-e2e-20261031/*.csv -text whitespace=cr-at-eol
/reports/pi3-q5-path-profile-20261031/*.csv -text whitespace=cr-at-eol
/reports/pi3-three-way-20261031/*.csv -text whitespace=cr-at-eol
